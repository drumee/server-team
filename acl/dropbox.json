{
  "services": {
    "list_files": {
      "doc": "List files/folders from Dropbox",
      "scope": "hub",
      "permission": {
        "src": "read"
      }
    },
    "import_file": {
      "doc": "Import a single file from Dropbox",
      "scope": "hub",
      "permission": {
        "src": "write"
      }
    },
    "import_directory": {
      "doc": "Import entire directory recursively from Dropbox",
      "scope": "hub",
      "permission": {
        "src": "write"
      }
    }
  },
  "modules": {
    "private": "service/private/dropbox"
  }
}