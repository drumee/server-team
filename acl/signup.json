{
  "services": {
    "create_account": {
      "doc": "Create a new Drumee account via the signup plugin. Checks for existing user, creates account schema from pool, auto-logs in the new user, and sends a welcome email.",
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      },
      "log": true,
      "params": {
        "email": {
          "type": "string",
          "required": true,
          "description": "User email address (becomes login identifier)"
        },
        "password": {
          "type": "string",
          "required": true,
          "description": "User password (must meet password requirements)"
        }
      },
      "returns": {
        "type": "object",
        "description": "On success, returns session data from auto-login (status: ok). On error, returns status object.",
        "properties": {
          "status": {
            "type": "string",
            "description": "Status code: ok | user_exists | server_busy | server_error | internal_error"
          },
          "email": {
            "type": "string",
            "description": "Email address (present when user_exists)"
          }
        }
      },
      "errors": [
        {
          "code": "USER_EXISTS",
          "message": "Email already registered",
          "returns": { "status": "user_exists", "email": "user@example.com" }
        },
        {
          "code": "SERVER_BUSY",
          "message": "No available schema pools",
          "returns": { "status": "server_busy" }
        },
        {
          "code": "SERVER_ERROR",
          "message": "Database or internal error during account creation",
          "returns": { "status": "server_error" }
        }
      ]
    }
  },

  "modules": {
    "private": "service/signup",
    "public": "service/signup"
  }
}
