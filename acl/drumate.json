{
  "services": {
    "get_profile": {
      "doc": "Get current user's complete profile information",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "returns": {
        "id": {
          "type": "string",
          "doc": "User ID"
        },
        "email": {
          "type": "string",
          "doc": "User email address"
        },
        "firstname": {
          "type": "string",
          "doc": "First name"
        },
        "lastname": {
          "type": "string",
          "doc": "Last name"
        },
        "fullname": {
          "type": "string",
          "doc": "Full name"
        },
        "profile": {
          "type": "object",
          "doc": "Extended profile information (JSON)"
        }
      }
    },
    "update_profile": {
      "doc": "Update user profile information (may require OTP verification for sensitive fields)",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "profile": {
          "type": "object",
          "required": true,
          "doc": "Profile fields to update (firstname, lastname, mobile, address, etc.)"
        },
        "secret": {
          "type": "string",
          "required": false,
          "doc": "OTP secret (required if OTP verification needed)"
        },
        "code": {
          "type": "string",
          "required": false,
          "doc": "OTP code (required if OTP verification needed)"
        }
      },
      "returns": {
        "profile": {
          "type": "object",
          "doc": "Updated profile information"
        }
      },
      "errors": [
        {
          "code": "WRONG_PASSWORD",
          "message": "OTP code is incorrect",
          "http_status": 401
        }
      ]
    },
    "get_referral_code": {
      "doc": "Get or create the signed-in user's referral code and link.",
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "change_password": {
      "doc": "Change user password with old password verification",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "old_password": {
          "type": "string",
          "required": false,
          "doc": "Current password for verification (password-backed accounts)"
        },
        "new_password": {
          "type": "string",
          "required": true,
          "minLength": 8,
          "doc": "New password (minimum 8 characters)"
        },
        "secret": {
          "type": "string",
          "required": false,
          "doc": "OTP secret (OAuth-only accounts verifying via email code)"
        },
        "code": {
          "type": "string",
          "required": false,
          "doc": "OTP code (OAuth-only accounts verifying via email code)"
        },
        "logout_others": {
          "type": "number",
          "required": false,
          "doc": "1 = terminate every other session of this user after the password change (the calling session stays alive)"
        }
      },
      "returns": {
        "status": {
          "type": "string",
          "doc": "success or error code"
        },
        "error": {
          "type": "string",
          "doc": "Error code if failed: wrong_password or uncompliant_password"
        }
      },
      "errors": [
        {
          "code": "wrong_password",
          "message": "Current password is incorrect",
          "http_status": 401
        },
        {
          "code": "uncompliant_password",
          "message": "New password does not meet requirements (minimum 8 characters)",
          "http_status": 400
        }
      ]
    },
    "change_email": {
      "doc": "Change user email address. Verifier branches on profile.password_set: password OR (secret+code).",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "email": {
          "type": "string",
          "required": true,
          "pattern": "^[^@]+@[^@]+\\.[^@]+$",
          "doc": "New email address"
        },
        "password": {
          "type": "string",
          "required": false,
          "doc": "Required when password_set=1"
        },
        "secret": {
          "type": "string",
          "required": false,
          "doc": "OTP secret (required when password_set=0)"
        },
        "code": {
          "type": "string",
          "required": false,
          "minLength": 6,
          "maxLength": 6,
          "doc": "OTP code (required when password_set=0)"
        }
      },
      "returns": {
        "email": {
          "type": "string",
          "doc": "Updated email address"
        }
      },
      "errors": [
        {
          "code": "INVALID_EMAIL_FORMAT",
          "message": "Email format is invalid",
          "http_status": 400
        },
        {
          "code": "EMAIL_ALREADY_EXIST",
          "message": "Email address is already in use",
          "http_status": 409
        }
      ]
    },
    "data_usage": {
      "doc": "Get current disk usage and quota information for user",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "returns": {
        "usage": {
          "type": "number",
          "doc": "Current disk usage in bytes"
        },
        "quota": {
          "type": "object",
          "doc": "Quota limits",
          "properties": {
            "storage": {
              "type": "number",
              "doc": "Total storage quota in bytes"
            },
            "real": {
              "type": "number",
              "doc": "Real available space"
            }
          }
        }
      }
    },
    "notification_center": {
      "doc": "Get list of all notifications for current user",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "returns": {
        "notifications": {
          "type": "array",
          "doc": "Array of notification objects",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "doc": "Notification ID"
              },
              "entity_id": {
                "type": "string",
                "doc": "Related entity (hub or user) ID"
              },
              "type": {
                "type": "string",
                "doc": "Notification type"
              },
              "count": {
                "type": "number",
                "doc": "Unread count"
              }
            }
          }
        }
      }
    },
    "logout": {
      "doc": "Logout user and cleanup session",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "log": true,
      "params": {
        "device_id": {
          "type": "string",
          "required": false,
          "doc": "Device ID to unregister (for mobile devices)"
        }
      },
      "returns": {
        "session_id": {
          "type": "string",
          "doc": "Terminated session ID"
        }
      }
    },
    "get_otp": {
      "doc": "Generate and send One-Time Password via SMS or email",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "returns": {
        "secret": {
          "type": "string",
          "doc": "OTP secret token for verification"
        },
        "expiry": {
          "type": "number",
          "doc": "OTP expiration timestamp"
        },
        "tips": {
          "type": "string",
          "doc": "Hint showing where OTP was sent (last 4 digits of phone or email domain)"
        },
        "error": {
          "type": "string",
          "doc": "Error message if OTP could not be sent"
        }
      },
      "errors": [
        {
          "code": "OTP_NOT_AVAILABLE",
          "message": "OTP service is not enabled",
          "http_status": 503
        },
        {
          "code": "INVALID_PROFILE",
          "message": "No valid phone or email in profile",
          "http_status": 400
        }
      ]
    },
    "set_avatar": {
      "doc": "Set user avatar using a media file from MFS",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "reference": {
          "type": "string",
          "required": true,
          "doc": "Node ID of image file in MFS to use as avatar"
        }
      },
      "returns": {
        "id": {
          "type": "string",
          "doc": "User ID"
        },
        "avatar": {
          "type": "string",
          "doc": "Avatar URL"
        }
      },
      "errors": [
        {
          "code": "no_avatar",
          "message": "Avatar file not found or not accessible",
          "http_status": 404
        }
      ]
    },
    "remove_avatar": {
      "doc": "Remove user avatar and restore default",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "returns": {
        "id": {
          "type": "string",
          "doc": "User ID"
        },
        "avatar": {
          "type": "string",
          "doc": "Default avatar URL"
        }
      }
    },
    "my_hubs": {
      "doc": "Get paginated list of hubs that user owns",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number for pagination"
        }
      },
      "returns": {
        "hubs": {
          "type": "array",
          "doc": "Array of hub objects",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "doc": "Hub ID"
              },
              "name": {
                "type": "string",
                "doc": "Hub name"
              },
              "area": {
                "type": "string",
                "doc": "Hub area: private, public, or share"
              },
              "owner_id": {
                "type": "string",
                "doc": "Owner user ID"
              }
            }
          }
        }
      }
    },
    "disk_space": {
      "doc": "Get detailed MFS manifest showing all files and folders with sizes",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "returns": {
        "manifest": {
          "type": "array",
          "doc": "Array of all media items with detailed metadata",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "doc": "Node ID"
              },
              "filename": {
                "type": "string",
                "doc": "File or folder name"
              },
              "filesize": {
                "type": "number",
                "doc": "Size in bytes"
              },
              "category": {
                "type": "string",
                "doc": "Node category"
              }
            }
          }
        }
      }
    },
    "show_login_log": {
      "doc": "Get paginated login history with device and location information",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number for pagination"
        }
      },
      "returns": {
        "sessions": {
          "type": "array",
          "doc": "Array of login session objects",
          "items": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string",
                "doc": "Login location city"
              },
              "ip": {
                "type": "string",
                "doc": "IP address"
              },
              "intime": {
                "type": "number",
                "doc": "Login timestamp"
              },
              "outtime": {
                "type": "number",
                "doc": "Logout timestamp (null if still active)"
              },
              "status": {
                "type": "string",
                "doc": "Session status"
              },
              "device": {
                "type": "object",
                "doc": "Parsed device information from user agent",
                "properties": {
                  "family": {
                    "type": "string",
                    "doc": "Device family (OS/Browser/Version or Vendor/Model/Type)"
                  }
                }
              }
            }
          }
        }
      }
    },
    "tutorial_seen": {
      "doc": "Record that one contextual tutorial tour has been shown to this user, and return the whole seen-map. First-write-wins and idempotent: repeating a tour_id returns the existing timestamp rather than an error. Tour ids MUST stay in sync with two other sites: the allow-list constant in service/private/drumate.js and the TOURS registry in ui-team src/drumee/modules/desk/tutorial/tours.js. Allowed: workspace, folder_task, share, migrate. TODO(OQ4): flip \"log\" to true once privacy sign-off lands — see plan §4 S9; it is false for now so Phase 1 creates no per-user behavioural rows in services_log that might later have to be deleted.",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "log": false,
      "params": {
        "tour_id": {
          "type": "string",
          "required": false,
          "doc": "One of: workspace, folder_task, share, migrate. Ignored when reset is set."
        },
        "reset": {
          "type": "number",
          "required": false,
          "doc": "1 = QA reset: empty the seen-map and drop the legacy tutorial_done flag. Refused unless the caller's profile carries devel:1."
        }
      },
      "returns": {
        "tutorials_seen": {
          "type": "object",
          "doc": "Map of tour_id to the unix timestamp at which it was first shown"
        }
      }
    },
    "update_settings": {
      "doc": "Update user settings (merged with existing settings)",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "settings": {
          "type": "object",
          "required": true,
          "doc": "Settings object to merge with existing settings"
        }
      },
      "returns": {
        "settings": {
          "type": "object",
          "doc": "Updated complete settings object"
        }
      }
    },
    "notification_remove": {
      "doc": "Mark notifications as read/acknowledged for a specific entity (hub or user)",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "entity_id": {
          "type": "string",
          "required": false,
          "doc": "Entity ID (hub_id or user_id) to mark notifications as read. Empty to mark all."
        }
      },
      "returns": {
        "ok": {
          "type": "number",
          "doc": "Success indicator (1)"
        }
      }
    },
    "delete_account": {
      "doc": "Initiate account deletion. Verifier branches on profile.password_set: password OR (secret+code).",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "log": true,
      "params": {
        "password": {
          "type": "string",
          "required": false,
          "doc": "Required when password_set=1"
        },
        "secret": {
          "type": "string",
          "required": false,
          "doc": "OTP secret (required when password_set=0)"
        },
        "code": {
          "type": "string",
          "required": false,
          "minLength": 6,
          "maxLength": 6,
          "doc": "OTP code (required when password_set=0)"
        }
      },
      "returns": {
        "secret": {
          "type": "string",
          "doc": "Deletion confirmation token (sent to email)"
        }
      },
      "errors": [
        {
          "code": "_invalid_key",
          "message": "OTP verification failed",
          "http_status": 401
        }
      ]
    },
    "list_oauth_links": {
      "doc": "List OAuth providers linked to this account.",
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "unlink_oauth": {
      "doc": "Disconnect an OAuth provider. Refuses if it would leave the account with no auth method.",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "log": true,
      "params": {
        "provider": {
          "type": "string",
          "required": true,
          "doc": "OAuth provider key (google|apple|...)"
        },
        "password": {
          "type": "string",
          "required": false
        },
        "secret": {
          "type": "string",
          "required": false
        },
        "code": {
          "type": "string",
          "required": false,
          "minLength": 6,
          "maxLength": 6
        }
      }
    },
    "set_initial_password": {
      "doc": "Set first password for an OAuth-only account. OTP-gated. Refuses if a password already exists.",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "log": true,
      "params": {
        "password": {
          "type": "string",
          "required": true
        },
        "secret": {
          "type": "string",
          "required": true
        },
        "code": {
          "type": "string",
          "required": true,
          "minLength": 6,
          "maxLength": 6
        }
      }
    },
    "confirm_delete_account": {
      "doc": "Confirm and execute account deletion (freezes account, removes from hubs, sends reactivation link)",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "secret": {
          "type": "string",
          "required": true,
          "doc": "Deletion confirmation token from delete_account"
        }
      },
      "returns": {
        "rejected": {
          "type": "number",
          "doc": "1 if deletion rejected (invalid secret)"
        },
        "reason": {
          "type": "string",
          "doc": "Rejection reason code"
        }
      },
      "errors": [
        {
          "code": "_invalid_secret",
          "message": "Deletion token is invalid or expired",
          "http_status": 401
        }
      ]
    },
    "update_ident": {
      "doc": "Change user's ident/username (must be unique within domain)",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "ident": {
          "type": "string",
          "required": true,
          "doc": "New username/ident"
        },
        "id": {
          "type": "string",
          "required": true,
          "doc": "User ID to update"
        }
      },
      "returns": {
        "id": {
          "type": "string",
          "doc": "User ID"
        },
        "ident": {
          "type": "string",
          "doc": "Updated ident"
        },
        "username": {
          "type": "string",
          "doc": "Updated username"
        }
      },
      "errors": [
        {
          "code": "_ident_already_exists",
          "message": "Username is already taken in this domain",
          "http_status": 409
        }
      ]
    },
    "helpdesk": {
      "doc": "Get paginated helpdesk messages in user's language",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "Xlang": {
          "type": "string",
          "required": false,
          "doc": "Language code (defaults to user's language)"
        },
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number for pagination"
        }
      },
      "returns": {
        "messages": {
          "type": "array",
          "doc": "Array of helpdesk message objects",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "doc": "Message ID"
              },
              "metadata": {
                "type": "object",
                "doc": "Message metadata (parsed from JSON)"
              }
            }
          }
        }
      }
    },
    "change_mobile": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "check_password": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "color_add": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "color_last": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "contacts": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "drumate_hubs": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "font_add": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "font_last": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "get_drumate_detail": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "get_languages": {
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      }
    },
    "hubs": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "intro_acknowledged": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "log": true
    },
    "mark_onboarding_complete": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "log": true
    },
    "my_contacts": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "method": "contacts"
    },
    "backup_size": {
      "doc": "Byte size of each backup category (files, chat, workspace, activity) so the export dialog can show what the download will contain. Read-only; counts the same mfs_manifest rows offline/drumate/backup.js archives.",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "returns": {
        "files": {
          "type": "number",
          "doc": "Bytes of user-owned files"
        },
        "chat": {
          "type": "number",
          "doc": "Bytes of team chat text"
        },
        "workspace": {
          "type": "number",
          "doc": "Bytes of workspace files the user can access"
        },
        "activity": {
          "type": "number",
          "doc": "Approximate bytes of the activity CSVs"
        }
      },
      "method": "backup_size"
    },
    "backup": {
      "doc": "Export user data as a ZIP archive. Accepts flags: personal (user-owned files/folders), hubs (workspace files where user has download permission), chat (P2P chat history per peer as CSV), logs (services_log + mfs_changelog + contact_activity as CSV). Runs as offline queue job — download link sent via email on completion.",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {
        "flags": {
          "type": "array",
          "required": true,
          "doc": "One or more of: files (user-owned files/folders), workspace (hub files where user has access), chat (team chat history per hub as CSV), activity (services_log + mfs_changelog + contact_activity as CSV)"
        },
        "socket_id": {
          "type": "string",
          "required": true,
          "doc": "WebSocket connection ID for real-time progress notifications"
        }
      },
      "returns": {
        "zipid": {
          "type": "string",
          "doc": "Unique job ID — used by frontend to track progress via WebSocket events"
        },
        "status": {
          "type": "string",
          "doc": "Always 'queued' — confirms the job was accepted"
        }
      }
    },
    "reset_forgot_password": {
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      }
    },
    "send_account_deletion_code": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "send_forgot_password_token": {
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      }
    },
    "set_lang": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "show_backup_log": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "validate_account_deletion_code": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "validate_forgot_password_token": {
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      }
    },
    "verify_email": {
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      }
    },
    "check_drumate_exist": {
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      }
    }
  },
  "modules": {
    "private": "service/private/drumate",
    "public": "service/yp"
  }
}
