{
  "services": {
    "upload": {
      "doc": "Upload new file to MFS (with quota and permission checks)",
      "scope": "hub",
      "permission": {
        "src": "write",
        "preproc": {
          "checker": "pre_upload"
        }
      },
      "params": {
        "pid": {
          "type": "string",
          "required": true,
          "doc": "Parent folder ID where file will be uploaded"
        },
        "file": {
          "type": "file",
          "required": true,
          "doc": "File to upload (multipart/form-data)"
        },
        "filename": {
          "type": "string",
          "required": true,
          "maxLength": 126,
          "doc": "Original filename"
        },
        "filesize": {
          "type": "number",
          "required": false,
          "doc": "File size in bytes (for quota checking)"
        },
        "md5Hash": {
          "type": "string",
          "required": false,
          "doc": "MD5 hash for deduplication"
        },
        "metadata": {
          "type": "object",
          "required": false,
          "doc": "Additional file metadata"
        },
        "replace": {
          "type": "number",
          "required": false,
          "enum": [0, 1],
          "default": 0,
          "doc": "Replace existing file (1) or create new (0)"
        },
        "ownpath": {
          "type": "string",
          "required": false,
          "doc": "Absolute path within hub (will create parent folders if not exist)"
        }
      },
      "returns": {
        "id": {
          "type": "string",
          "doc": "New file node ID"
        },
        "nid": {
          "type": "string",
          "doc": "New file node ID (alias)"
        },
        "filename": {
          "type": "string",
          "doc": "Uploaded filename"
        },
        "filesize": {
          "type": "number",
          "doc": "File size in bytes"
        },
        "category": {
          "type": "string",
          "doc": "File category: image, video, audio, document, web, archive, etc"
        },
        "extension": {
          "type": "string",
          "doc": "File extension"
        },
        "mimetype": {
          "type": "string",
          "doc": "MIME type"
        },
        "mtime": {
          "type": "number",
          "doc": "Modification timestamp"
        },
        "ctime": {
          "type": "number",
          "doc": "Creation timestamp"
        }
      },
      "errors": [
        {
          "code": "INSUFFICIENT_STORAGE",
          "message": "Not enough storage quota",
          "http_status": 507
        },
        {
          "code": "PERMISSION_DENIED",
          "message": "No write permission on destination folder",
          "http_status": 403
        },
        {
          "code": "FAILED_CREATE_FILE",
          "message": "File creation failed",
          "http_status": 500
        },
        {
          "code": "INVALID_FILENAME",
          "message": "Filename contains invalid characters",
          "http_status": 400
        },
        {
          "code": "OWNPATH_INCONSISTENT",
          "message": "ownpath must use home_id as base",
          "http_status": 400
        }
      ]
    },
    "download": {
      "doc": "Download file from MFS",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Node ID of file to download"
        }
      },
      "returns": {
        "file": {
          "type": "binary",
          "doc": "File content stream"
        }
      },
      "errors": [
        {
          "code": "NODE_NOT_FOUND",
          "message": "File does not exist",
          "http_status": 404
        },
        {
          "code": "PERMISSION_DENIED",
          "message": "No read permission",
          "http_status": 403
        }
      ]
    },
    "make_dir": {
      "doc": "Create new directory/folder in MFS",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "dirname": {
          "type": "string",
          "required": false,
          "maxLength": 255,
          "doc": "Directory name (use with pid). Slashes will be replaced with dashes"
        },
        "pid": {
          "type": "string",
          "required": false,
          "doc": "Parent folder ID (required if using dirname)"
        },
        "ownpath": {
          "type": "string",
          "required": false,
          "doc": "Absolute path within hub (alternative to dirname+pid). Will create parent folders if they don't exist"
        },
        "metadata": {
          "type": "object",
          "required": false,
          "doc": "Additional folder metadata"
        }
      },
      "returns": {
        "nid": {
          "type": "string",
          "doc": "New folder node ID"
        },
        "filename": {
          "type": "string",
          "doc": "Folder name"
        },
        "category": {
          "type": "string",
          "doc": "folder"
        },
        "parent_id": {
          "type": "string",
          "doc": "Parent folder ID"
        }
      },
      "errors": [
        {
          "code": "INVALID_FILENAME",
          "message": "Filename contains invalid characters (., ./, space only, etc)",
          "http_status": 400
        },
        {
          "code": "FAILED_CREATE_FOLDER",
          "message": "Directory creation failed",
          "http_status": 500
        },
        {
          "code": "PERMISSION_DENIED",
          "message": "No write permission",
          "http_status": 403
        }
      ]
    },
    "trash": {
      "doc": "Move file/folder to trash bin",
      "scope": "hub",
      "permission": {
        "src": "delete",
        "preproc": {
          "checker": "pre_trash"
        }
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Node ID to trash (can be array for batch operation)"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Array of trashed items",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "doc": "Node ID"
              },
              "nid": {
                "type": "string",
                "doc": "Node ID (alias)"
              },
              "status": {
                "type": "string",
                "doc": "New status: deleted"
              },
              "delete_time": {
                "type": "number",
                "doc": "Timestamp when trashed"
              }
            }
          }
        },
        "args": {
          "type": "object",
          "doc": "Changelog info",
          "properties": {
            "changelog": {
              "type": "object",
              "doc": "Change tracking data"
            }
          }
        }
      },
      "errors": [
        {
          "code": "PERMISSION_DENIED",
          "message": "No delete permission",
          "http_status": 403
        },
        {
          "code": "NODE_NOT_FOUND",
          "message": "Node does not exist",
          "http_status": 404
        },
        {
          "code": "LOCKED",
          "message": "Item is locked and cannot be deleted",
          "http_status": 403
        },
        {
          "code": "_delete_hub",
          "message": "Cannot delete hub",
          "http_status": 403
        }
      ]
    },
    "move_all": {
      "doc": "Move files/folders to different location",
      "scope": "hub",
      "permission": {
        "src": "delete",
        "dest": "write",
        "preproc": {
          "checker": "pre_transact",
          "action": "move"
        }
      },
      "params": {
        "nodes": {
          "type": "array",
          "required": true,
          "doc": "Array of source node IDs to move",
          "items": {
            "type": "string"
          }
        },
        "dest_id": {
          "type": "string",
          "required": true,
          "doc": "Destination folder ID"
        },
        "recipient_id": {
          "type": "string",
          "required": false,
          "doc": "Target hub ID (if moving cross-hub)"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Array of moved items with new locations"
        },
        "denied_lst": {
          "type": "array",
          "doc": "List of items that could not be moved due to permission"
        }
      },
      "errors": [
        {
          "code": "CIRCULAR_REF",
          "message": "Cannot move folder into itself",
          "http_status": 400
        },
        {
          "code": "DESTINATION_IS_NOT_DIRECTORY",
          "message": "Destination must be a folder",
          "http_status": 400
        },
        {
          "code": "UNABLE_TO_TRANS_INBOUND",
          "message": "Cannot move inbound items",
          "http_status": 403
        },
        {
          "code": "WICKET_HUB",
          "message": "Cannot move to wicket hub",
          "http_status": 403
        }
      ]
    },
    "copy_all": {
      "doc": "Copy files/folders to different location",
      "scope": "hub",
      "permission": {
        "src": "read",
        "dest": "write",
        "preproc": {
          "checker": "pre_transact",
          "action": "copy"
        }
      },
      "params": {
        "nodes": {
          "type": "array",
          "required": true,
          "doc": "Array of source node IDs to copy",
          "items": {
            "type": "string"
          }
        },
        "dest_id": {
          "type": "string",
          "required": true,
          "doc": "Destination folder ID"
        },
        "recipient_id": {
          "type": "string",
          "required": false,
          "doc": "Target hub ID (if copying cross-hub)"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Array of copied items with new IDs"
        }
      },
      "errors": [
        {
          "code": "INSUFFICIENT_STORAGE",
          "message": "Not enough storage quota for copy",
          "http_status": 507
        },
        {
          "code": "your_limit_exceeded",
          "message": "Your storage limit exceeded",
          "http_status": 507
        },
        {
          "code": "limit_exceeded",
          "message": "Organization storage limit exceeded",
          "http_status": 507
        }
      ]
    },
    "rename": {
      "doc": "Rename file or folder",
      "scope": "hub",
      "permission": {
        "src": "delete"
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Node ID to rename"
        },
        "filename": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 255,
          "doc": "New filename"
        }
      },
      "returns": {
        "id": {
          "type": "string",
          "doc": "Node ID"
        },
        "nid": {
          "type": "string",
          "doc": "Node ID (alias)"
        },
        "filename": {
          "type": "string",
          "doc": "Updated filename"
        },
        "args": {
          "type": "object",
          "doc": "Changelog and sync info",
          "properties": {
            "dest": {
              "type": "object",
              "doc": "New node state"
            },
            "src": {
              "type": "object",
              "doc": "Old node state"
            },
            "tag": {
              "type": "string",
              "doc": "Transaction tag for sync"
            },
            "changelog": {
              "type": "object",
              "doc": "Change tracking data"
            }
          }
        }
      },
      "errors": [
        {
          "code": "FILENAME_EXISTS",
          "message": "A file with this name already exists",
          "http_status": 409
        },
        {
          "code": "INVALID_FILENAME",
          "message": "Filename contains invalid characters",
          "http_status": 400
        },
        {
          "code": "UNABLE_TO_RENAME_INBOUND",
          "message": "Cannot rename inbound items",
          "http_status": 403
        }
      ]
    },
    "show_bin": {
      "doc": "Get paginated list of files in trash bin",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "params": {
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number for pagination"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Array of trashed items",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "doc": "Node ID"
              },
              "filename": {
                "type": "string",
                "doc": "Filename"
              },
              "status": {
                "type": "string",
                "doc": "deleted"
              },
              "delete_time": {
                "type": "number",
                "doc": "Timestamp when trashed"
              },
              "category": {
                "type": "string",
                "doc": "File category"
              },
              "filesize": {
                "type": "number",
                "doc": "File size in bytes"
              }
            }
          }
        }
      }
    },
    "empty_bin": {
      "doc": "Permanently delete all files from trash bin (queued background job if trash_expiry enabled)",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "returns": {
        "status": {
          "type": "string",
          "doc": "queued (if using background job) or immediate completion"
        },
        "job_id": {
          "type": "string",
          "doc": "Job ID if queued"
        },
        "message": {
          "type": "string",
          "doc": "Status message"
        },
        "deleted_count": {
          "type": "number",
          "doc": "Number of items permanently deleted (if immediate)"
        },
        "freed_space": {
          "type": "number",
          "doc": "Storage space freed in bytes (if immediate)"
        }
      },
      "errors": [
        {
          "code": "FAILED_TO_QUEUE_TRASH_CLEANUP",
          "message": "Failed to queue trash cleanup job",
          "http_status": 500
        }
      ]
    },
    "purge": {
      "doc": "Permanently delete specific items from trash bin",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "params": {
        "list": {
          "type": "array",
          "required": false,
          "default": [],
          "doc": "Array of node IDs to purge. Empty array = purge all",
          "items": {
            "type": "string"
          }
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Array of purged node IDs"
        }
      }
    },
    "restore_into": {
      "doc": "Restore files/folders from trash to specified location",
      "scope": "hub",
      "permission": {
        "src": "read",
        "dest": "write",
        "preproc": {
          "checker": "pre_restore_into",
          "action": "move"
        }
      },
      "params": {
        "nodes": {
          "type": "array",
          "required": true,
          "doc": "Array of node IDs to restore",
          "items": {
            "type": "string"
          }
        },
        "dest_id": {
          "type": "string",
          "required": true,
          "doc": "Destination folder ID where items will be restored"
        },
        "recipient_id": {
          "type": "string",
          "required": false,
          "doc": "Target hub ID (if restoring to different hub)"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Array of restored items with new locations"
        },
        "denied": {
          "type": "array",
          "doc": "Items that could not be restored due to permission"
        }
      }
    },
    "restore": {
      "doc": "Restore a trashed file or folder to its original location. If the original parent no longer exists, returns parent_missing=1 so the FE can show a location picker and fall back to restore_into.",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Node ID of the trashed item to restore (from show_bin results)"
        }
      },
      "returns": {
        "parent_missing": {
          "type": "number",
          "doc": "1 if original parent no longer exists. FE should show location picker and call restore_into."
        },
        "original_parent_id": {
          "type": "string",
          "doc": "Original parent ID (only present when parent_missing=1). FE can use to show context."
        },
        "nid": {
          "type": "string",
          "doc": "Node ID (only present when parent_missing=1)"
        }
      },
      "errors": [
        {
          "code": "RESTORE_FAILED",
          "message": "Could not restore node (e.g. attempted to restore root)",
          "http_status": 400
        }
      ]
    },
    "show_node_by": {
      "doc": "Get paginated list of files/folders with sorting",
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Parent folder ID to browse"
        },
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number"
        },
        "sort": {
          "type": "string",
          "required": false,
          "default": "rank",
          "enum": ["rank", "date", "size", "sort"],
          "doc": "Sort field"
        },
        "order": {
          "type": "string",
          "required": false,
          "default": "asc",
          "enum": ["asc", "desc"],
          "doc": "Sort direction"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Array of media items"
        }
      }
    },
    "show_node_by_with_size": {
      "doc": "Get paginated list of files/folders with sorting (includes folder sizes)",
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Parent folder ID to browse"
        },
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number"
        },
        "sort": {
          "type": "string",
          "required": false,
          "default": "rank",
          "enum": ["rank", "date", "size", "sort"],
          "doc": "Sort field"
        },
        "order": {
          "type": "string",
          "required": false,
          "default": "asc",
          "enum": ["asc", "desc"],
          "doc": "Sort direction"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Array of items with calculated folder sizes"
        }
      }
    },
    "manifest": {
      "doc": "Get folder structure manifest (for export/import operations)",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Root folder ID for manifest"
        }
      },
      "returns": {
        "nodes": {
          "type": "array",
          "doc": "Hierarchical list of all files and folders",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "doc": "Node ID"
              },
              "nid": {
                "type": "string",
                "doc": "Node ID (alias)"
              },
              "filename": {
                "type": "string",
                "doc": "Filename"
              },
              "file_path": {
                "type": "string",
                "doc": "Full path from root"
              },
              "category": {
                "type": "string",
                "doc": "file or folder"
              },
              "filesize": {
                "type": "number",
                "doc": "File size in bytes"
              }
            }
          }
        },
        "total_size": {
          "type": "number",
          "doc": "Total size of all items in bytes"
        }
      }
    },
    "search_all": {
      "doc": "Unified search: filenames + indexed content from documents/images",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "params": {
        "string": {
          "type": "string",
          "required": false,
          "doc": "Search query string (alternative to 'query')"
        },
        "query": {
          "type": "string",
          "required": false,
          "doc": "Search query string (alternative to 'string')"
        },
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number for pagination"
        },
        "limit": {
          "type": "number",
          "required": false,
          "default": 20,
          "min": 1,
          "max": 100,
          "doc": "Results per page"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Search results ranked by relevance: exact filename match (highest) → filename contains → extension match → content match (lowest)",
          "items": {
            "type": "object",
            "properties": {
              "nid": {
                "type": "string",
                "doc": "Node ID"
              },
              "filename": {
                "type": "string",
                "doc": "Filename"
              },
              "category": {
                "type": "string",
                "doc": "File category"
              },
              "relevance": {
                "type": "number",
                "doc": "Relevance score"
              },
              "match_type": {
                "type": "string",
                "doc": "filename, extension, or content"
              }
            }
          }
        }
      }
    },
    "search_names": {
      "doc": "Search up to six live, readable filenames or relative paths below an authorized folder using the local readiness-checked projection",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Authorized folder node ID that bounds the live subtree search"
        },
        "query": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 128,
          "doc": "Literal filename or current relative-path filter"
        },
        "limit": {
          "type": "number",
          "required": false,
          "default": 6,
          "min": 1,
          "max": 6,
          "doc": "Maximum ranked suggestions returned"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Deterministically ranked current descendants",
          "items": {
            "type": "object",
            "properties": {
              "nid": { "type": "string", "doc": "Node ID" },
              "hub_id": { "type": "string", "doc": "Authoritative hub ID" },
              "parent_id": { "type": "string", "doc": "Current parent node ID" },
              "filename": { "type": "string", "doc": "Current filename without extension" },
              "filetype": { "type": "string", "doc": "Renderer file type" },
              "ext": { "type": "string", "doc": "Filename extension" },
              "mimetype": { "type": "string", "doc": "Media MIME type" },
              "capability": { "type": "string", "doc": "Renderer capability" },
              "area": { "type": "string", "doc": "Authoritative hub area" },
              "isalink": { "type": "number", "doc": "Whether the row is a link" },
              "mention_path": { "type": "string", "doc": "Current relative path from the scoped folder" }
            }
          }
        }
      },
      "errors": [
        {
          "code": "INVALID_SEARCH_QUERY",
          "message": "Query must contain between 1 and 128 normalized characters",
          "http_status": 400
        },
        {
          "code": "SEARCH_NAMES_UNSUPPORTED_CONTEXT",
          "message": "Live projected name search is unavailable in this share context",
          "http_status": 409
        },
        {
          "code": "SEARCH_NAMES_BUSY",
          "message": "The live name-search capacity is busy",
          "http_status": 429
        },
        {
          "code": "SEARCH_NAMES_TIMEOUT",
          "message": "The live name search exceeded its database time budget",
          "http_status": 504
        },
        {
          "code": "SEARCH_NAMES_PROJECTION_NOT_READY",
          "message": "The live name-search projection is not ready for this database generation",
          "http_status": 503
        },
        {
          "code": "TREE_CYCLE",
          "message": "The scoped media tree contains a cycle",
          "http_status": 409
        },
        {
          "code": "TREE_DEPTH_EXCEEDED",
          "message": "The scoped media tree exceeds the supported depth",
          "http_status": 422
        },
        {
          "code": "MENTION_PATH_TOO_LONG",
          "message": "A scoped media path exceeds the supported length",
          "http_status": 422
        }
      ]
    },
    "get_by_type": {
      "doc": "Get paginated list of files filtered by category",
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      },
      "params": {
        "type": {
          "type": "string",
          "required": false,
          "default": "image",
          "enum": ["image", "video", "audio", "document", "web", "archive"],
          "doc": "File category to filter"
        },
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number"
        },
        "order": {
          "type": "string",
          "required": false,
          "enum": ["asc", "desc"],
          "doc": "Sort direction"
        },
        "sort": {
          "type": "string",
          "required": false,
          "enum": ["rank", "date", "size", "sort"],
          "doc": "Sort field"
        },
        "pid": {
          "type": "string",
          "required": false,
          "doc": "Parent folder ID (omit to search all)"
        },
        "showAll": {
          "type": "boolean",
          "required": false,
          "doc": "Search all folders (ignores pid)"
        }
      },
      "returns": {
        "items": {
          "type": "array",
          "doc": "Array of files matching type"
        }
      }
    },
    "info": {
      "doc": "Get detailed file information (type-specific: document pages, video duration, image dimensions, folder size)",
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Node ID to get info"
        }
      },
      "returns": {
        "stats": {
          "type": "object",
          "doc": "Basic file statistics (id, filename, category, filesize, etc)"
        },
        "pages": {
          "type": "number",
          "doc": "Number of pages (for documents)"
        },
        "pdf": {
          "type": "string",
          "doc": "Path to PDF version (for documents)"
        },
        "duration": {
          "type": "string",
          "doc": "Duration (for audio/video)"
        },
        "Image": {
          "type": "object",
          "doc": "Image metadata (geometry, format, etc)"
        },
        "total_size": {
          "type": "number",
          "doc": "Total size including subfolders (for folders)"
        },
        "status": {
          "type": "string",
          "doc": "working (PDF conversion in progress), ready, or na"
        }
      },
      "errors": [
        {
          "code": "FILE_NOT_FOUND",
          "message": "File does not exist or was deleted",
          "http_status": 404
        }
      ]
    },
    "get_node_attr": {
      "doc": "Get node attributes (optionally for a relative path within folder)",
      "scope": "hub",
      "permission": {
        "src": "anonymous"
      },
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Node ID"
        },
        "relpath": {
          "type": "string",
          "required": false,
          "doc": "Relative path from nid (e.g., 'subfolder/file.txt')"
        }
      },
      "returns": {
        "nid": {
          "type": "string",
          "doc": "Node ID"
        },
        "filename": {
          "type": "string",
          "doc": "Filename"
        },
        "category": {
          "type": "string",
          "doc": "File category"
        },
        "filesize": {
          "type": "number",
          "doc": "File size in bytes"
        },
        "mtime": {
          "type": "number",
          "doc": "Modification timestamp"
        },
        "permission": {
          "type": "number",
          "doc": "User's permission level"
        },
        "ownpath": {
          "type": "string",
          "doc": "Absolute path within hub"
        }
      }
    },
