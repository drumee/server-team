{
  "services": {
    "get_settings": {
      "doc": "Get comprehensive hub settings including owner, visitor privileges, and member list",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "returns": {
        "owner": {
          "type": "object",
          "doc": "Hub owner information"
        },
        "visitor": {
          "type": "object",
          "doc": "Current user's privilege information",
          "properties": {
            "privilege": {
              "type": "number",
              "doc": "User's privilege level in this hub"
            }
          }
        },
        "users": {
          "type": "array",
          "doc": "List of hub members (excluding system users)",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "doc": "User ID"
              },
              "privilege": {
                "type": "number",
                "doc": "User privilege level"
              }
            }
          }
        },
        "hubname": {
          "type": "string",
          "doc": "Hub name"
        },
        "default_privilege": {
          "type": "number",
          "doc": "Default privilege for new members"
        }
      }
    },
    "get_attributes": {
      "doc": "Get hub's complete attributes as JSON",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "returns": {
        "id": {
          "type": "string",
          "doc": "Hub ID"
        },
        "name": {
          "type": "string",
          "doc": "Hub name"
        },
        "area": {
          "type": "string",
          "doc": "Hub area (private, public, share)"
        },
        "owner_id": {
          "type": "string",
          "doc": "Owner user ID"
        },
        "settings": {
          "type": "object",
          "doc": "Hub settings object"
        }
      }
    },
    "get_contributors": {
      "doc": "Get paginated list of hub contributors/members",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "params": {
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number for pagination"
        },
        "privilege": {
          "type": "number",
          "required": false,
          "default": 0,
          "doc": "Filter by privilege level (0 for all)"
        }
      },
      "returns": {
        "contributors": {
          "type": "array",
          "doc": "Array of contributor objects",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "show_contributors": {
      "doc": "Show paginated list of hub contributors (alias for get_contributors)",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "params": {
        "page": {
          "type": "number",
          "required": false,
          "default": 1,
          "min": 1,
          "doc": "Page number for pagination"
        }
      },
      "returns": {
        "contributors": {
          "type": "array",
          "doc": "Array of contributor objects"
        }
      }
    },
    "invite_received_get": {
      "doc": "Return workspace invitations addressed to the current user. Reads yp.contact_activity rows logged by add_contributors.",
      "scope": "hub",
      "permission": {
        "src": "owner"
      },
      "params": {},
      "returns": {
        "type": "array",
        "doc": "List of workspace invitations",
        "items": {
          "id":            { "type": "integer", "doc": "Activity row id" },
          "ctime":         { "type": "integer", "doc": "Unix timestamp when invite was logged" },
          "author_id":     { "type": "string",  "doc": "Inviter uid" },
          "target_uid":    { "type": "string",  "doc": "Recipient uid (current user)" },
          "event":         { "type": "string",  "doc": "Always 'hub_invite_received'" },
          "hub_id":        { "type": "string",  "doc": "Workspace id" },
          "hub_name":      { "type": "string",  "doc": "Workspace name at the time of the invite" },
          "from_fullname": { "type": "string",  "doc": "Inviter's full name" },
          "message":       { "type": "string",  "doc": "Optional invite message" },
          "privilege":     { "type": "number",  "doc": "Privilege bitmask granted" }
        }
      },
      "errors": []
    },

    "accept_invite": {
      "doc": "Redeem a hub invite token and join the workspace. Called by the FE after sign-in when the welcome URL carries ?invite=SECRET.",
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      },
      "params": {
        "token": {
          "type": "string",
          "required": true,
          "doc": "The invite token secret from the email link"
        }
      },
      "returns": {
        "hub_id": { "type": "string", "doc": "Workspace ID on success" },
        "status": { "type": "string", "doc": "Error code when not ok: invalid | expired | already_used | hub_not_found | not_authenticated" }
      }
    },

    "decline_invite": {
      "doc": "Turn down a workspace invitation, by the token from its email link or its notification row. Holding the secret is the authorisation, exactly as it is for accept_invite - and this is the less dangerous of the two, since accepting grants access while declining only destroys an invitation. No session is required: an invitation usually goes to somebody with no account, and saying no must not cost them a signup. Never removes membership (that is desk.leave_hub) and refuses any token that is not an ACTIVE hub_invite, so a stale link pressed after joining cannot rewrite how somebody got in. Idempotent - declining twice keeps the first answer and reports the same result.",
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      },
      "params": {
        "token": {
          "type": "string",
          "required": true,
          "doc": "The invite token secret from the email link or the notification row"
        }
      },
      "returns": {
        "status": { "type": "string", "doc": "declined on success; invalid when the token is not a live hub invite; already_used when it was already accepted" },
        "hub_id": { "type": "string", "doc": "Workspace the invitation was for, when the token resolved one" }
      }
    },

    "invitations": {
      "doc": "Invitations this workspace is still waiting on, plus the ones that were turned down - the Pending Invitations section of the Access panel. One row per person, newest invitation wins. Accepted invitations are absent (those people are members) and so are lapsed ones. Current members are filtered out here rather than in the proc, because membership lives in the workspace database and hub_invitations reads yellow_page.",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "params": {},
      "returns": {
        "type": "array",
        "doc": "Pending and declined invitations",
        "items": {
          "email":             { "type": "string",  "doc": "Address the invitation was sent to" },
          "status":            { "type": "string",  "doc": "pending | declined" },
          "ctime":             { "type": "integer", "doc": "Unix timestamp the invitation was sent" },
          "permission":        { "type": "number",  "doc": "Privilege bitmask the invitation offers" },
          "invitee_uid":       { "type": "string",  "doc": "Invitee's Drumee user id, null when they have no account yet" },
          "invitee_firstname": { "type": "string",  "doc": "Invitee's first name when they have an account" },
          "invitee_lastname":  { "type": "string",  "doc": "Invitee's last name when they have an account" },
          "invitee_fullname":  { "type": "string",  "doc": "Invitee's display name when they have an account" },
          "invitee_avatar":    { "type": "string",  "doc": "Invitee's avatar when they have an account" },
          "inviter_id":        { "type": "string",  "doc": "Who sent it" },
          "inviter_firstname": { "type": "string",  "doc": "Inviter's first name" },
          "inviter_lastname":  { "type": "string",  "doc": "Inviter's last name" },
          "inviter_fullname":  { "type": "string",  "doc": "Inviter's display name" }
        }
      },
      "errors": []
    },

    "invite": {
      "doc": "Invite one or more emails into this workspace. Mints an invitation the recipient answers with Accept or Decline - it does NOT add anybody. An address that already has an account additionally gets a notification row carrying the token; every address gets the email. Membership is written by accept_invite.",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "params": {
        "invitees": {
          "type": "array",
          "required": true,
          "minItems": 1,
          "doc": "Array of email addresses to invite",
          "items": { "type": "string" }
        },
        "privilege": {
          "type": "number",
          "required": false,
          "doc": "Privilege level to grant (defaults to hub's default_privilege)"
        },
        "message": {
          "type": "string",
          "required": false,
          "doc": "Optional invitation message"
        }
      },
      "returns": {
        "results": {
          "type": "array",
          "doc": "Per-invitee result: { email, branch (A/B/C), status (ok/failed), reason? }"
        }
      }
    },
    "add_contributors": {
      "doc": "Add members to hub with privilege and expiry settings (sends notifications)",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "params": {
        "users": {
          "type": "array",
          "required": true,
          "minItems": 1,
          "doc": "Array of user IDs or emails to add",
          "items": {
            "type": "string"
          }
        },
        "privilege": {
          "type": "number",
          "required": false,
          "doc": "Privilege level to grant (defaults to hub's default_privilege)"
        },
        "hours": {
          "type": "number",
          "required": false,
          "default": 0,
          "doc": "Hours until membership expires"
        },
        "days": {
          "type": "number",
          "required": false,
          "default": 0,
          "doc": "Days until membership expires"
        },
        "message": {
          "type": "string",
          "required": false,
          "doc": "Optional message to send to new members"
        }
      },
      "returns": {
        "members": {
          "type": "array",
          "doc": "Updated list of hub members (not_owner type)"
        }
      }
    },
    "invite_with_roles": {
      "doc": "Invite users to multiple workspaces with per-workspace privilege. Called from the Home page Invite button. Accepts an array of emails/user IDs and an array of {hub_id, privilege} assignments.",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "log": true,
      "params": {
        "users": {
          "type": "array",
          "required": true,
          "minItems": 1,
          "doc": "Array of user IDs or email addresses to invite",
          "items": { "type": "string" }
        },
        "assignments": {
          "type": "array",
          "required": true,
          "minItems": 1,
          "doc": "Array of workspace-role pairs. Each item specifies a target hub and the privilege bitmask to grant.",
          "items": {
            "type": "object",
            "properties": {
              "hub_id": {
                "type": "string",
                "doc": "Target workspace (hub) ID"
              },
              "privilege": {
                "type": "number",
                "doc": "Privilege bitmask to grant in this workspace. E.g. Chat=2, Edit=4, Edit+Chat=6, Admin=15"
              }
            }
          }
        }
      },
      "returns": {
        "success": {
          "type": "boolean",
          "doc": "True if the operation completed without fatal errors"
        },
        "results": {
          "type": "array",
          "doc": "Per-workspace result summary",
          "items": {
            "type": "object",
            "properties": {
              "hub_id": { "type": "string", "doc": "Workspace ID" },
              "added":  { "type": "number", "doc": "Number of users immediately added as members" }
            }
          }
        }
      }
    },
    "delete_contributor": {
      "doc": "Remove members from hub (broadcasts removal notification)",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "params": {
        "users": {
          "type": "array",
          "required": true,
          "minItems": 1,
          "doc": "Array of user IDs to remove (cannot remove self)",
          "items": {
            "type": "string"
          }
        }
      },
      "returns": {
        "members": {
          "type": "array",
          "doc": "Updated list of remaining hub members"
        }
      }
    },
    "set_privilege": {
      "doc": "Set privilege level for multiple users (batch operation)",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "params": {
        "users": {
          "type": "array",
          "required": true,
          "minItems": 1,
          "doc": "Array of user IDs",
          "items": {
            "type": "string"
          }
        },
        "privilege": {
          "type": "number",
          "required": false,
          "doc": "Privilege level to set (defaults to hub's default_privilege)"
        },
        "permission": {
          "type": "number",
          "required": false,
          "doc": "Alias for privilege parameter"
        }
      },
      "returns": {
        "users": {
          "type": "array",
          "doc": "Array of user IDs that were updated"
        }
      }
    },
    "set_member_privilege": {
      "doc": "Set privilege level for a single member with optional expiry",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "params": {
        "uid": {
          "type": "string",
          "required": true,
          "doc": "User ID to update"
        },
        "privilege": {
          "type": "number",
          "required": false,
          "doc": "Privilege level to grant"
        },
        "permission": {
          "type": "number",
          "required": false,
          "doc": "Alias for privilege parameter"
        },
        "days": {
          "type": "number",
          "required": false,
          "default": 0,
          "doc": "Days until privilege expires"
        },
        "hours": {
          "type": "number",
          "required": false,
          "default": 0,
          "doc": "Hours until privilege expires"
        }
      },
      "returns": {
        "members": {
          "type": "array",
          "doc": "Updated list of hub members (not_owner type)"
        }
      }
    },
    "get_space_usage": {
      "doc": "Get hub's disk space usage statistics",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "returns": {
        "total": {
          "type": "number",
          "doc": "Total storage quota in bytes"
        },
        "selected": {
          "type": "number",
          "doc": "Space used by this hub in bytes"
        },
        "others": {
          "type": "number",
          "doc": "Space used by other hubs and user data in bytes"
        },
        "free": {
          "type": "number",
          "doc": "Free space available in bytes"
        }
      }
    },
    "update_name": {
      "doc": "Update hub name (must be unique, broadcasts change to members)",
      "scope": "hub",
      "permission": {
        "src": "admin"
      },
      "params": {
        "name": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "doc": "New hub name"
        }
      },
      "returns": {
        "id": {
          "type": "string",
          "doc": "Hub ID"
        },
        "hubname": {
          "type": "string",
          "doc": "Updated hub name"
        },
        "name": {
          "type": "string",
          "doc": "Updated hub name"
        },
        "fieldName": {
          "type": "string",
          "doc": "hubname"
        },
        "error": {
          "type": "string",
          "doc": "ALREADY_EXISTS if name is taken"
        }
      },
      "errors": [
        {
          "code": "ALREADY_EXISTS",
          "message": "Hub name is already in use",
          "http_status": 409
        }
      ]
    },
    "poke": {
      "doc": "Send notification to a user about activity in this hub",
      "scope": "hub",
      "permission": {
        "src": "read",
        "fast_check": "user_permission"
      },
      "params": {
        "uid": {
          "type": "string",
          "required": true,
          "doc": "User ID to notify"
        },
        "nid": {
          "type": "string",
          "required": true,
          "doc": "Node ID related to notification"
        },
        "kind": {
          "type": "string",
          "required": true,
          "doc": "Type of notification"
        }
      },
      "returns": {
        "sender": {
          "type": "string",
          "doc": "Sender user ID (current user)"
        },
        "recipient": {
          "type": "string",
          "doc": "Recipient user ID"
        }
      }
    },
    "logo": {
      "doc": "Get hub logo URL (public API, no authentication required)",
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      },
      "params": {
        "protocol": {
          "type": "string",
          "required": false,
          "doc": "Protocol (http or https)"
        },
        "localhost": {
          "type": "string",
          "required": false,
          "doc": "Localhost flag for local development"
        }
      },
      "returns": {
        "url": {
          "type": "string",
          "doc": "Full URL to hub logo image"
        }
      }
    },
    "add_external_member": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "add_font_link": {
      "scope": "hub",
      "permission": {
        "src": "delete"
      }
    },
    "change_history": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "change_owner": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "change_status": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "copy_link": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "delete_external_member": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "delete_hub": {
      "doc": "Destroy a workspace: drops its database and deletes its files on disk. IRREVERSIBLE - there is no trash, no backup and no undo, and the directory removal runs detached. Asks ADMIN, not owner, since 2026-09-17 (Lexis, via Duy). The owner bar it used to carry was never a real boundary: hub.change_owner and hub.set_privilege are themselves admin-gated and neither clamps what it writes, so any workspace admin could already take ownership in a single call and then delete. Requiring owner here only added a step, while leaving the client offering a Delete row that answered 403 - the row is gated on the admin bit, see ui-team window/folder/skeleton/settings-action-panel.js. Still refuses a non-hub entity type, so a personal workspace cannot come through here.",
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "get_action_log": {
      "scope": "hub",
      "permission": {
        "src": "read"
      }
    },
    "get_members_by_type": {
      "scope": "hub",
      "permission": {
        "src": "read"
      }
    },
    "get_pr_node_attr": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "get_statistics": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "hub_get_members_by_type": {
      "scope": "hub",
      "permission": {
        "src": "read"
      }
    },
    "login_image": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "lookup_hubers": {
      "scope": "hub",
      "permission": {
        "src": "read"
      }
    },
    "set_node_permission": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "show_privilege": {
      "scope": "hub",
      "permission": {
        "src": "read"
      }
    },
    "update_contributor": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "update_favicon": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "update_ident": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "update_settings": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "update_title": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "update_visibility": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "update_external_members": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "update_external_room": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "update_external_settings": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "get_external_room_attr": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    },
    "external_notification": {
      "scope": "hub",
      "permission": {
        "src": "admin"
      }
    }
  },
  "modules": {
    "private": "service/private/hub",
    "public": "service/hub"
  }
}